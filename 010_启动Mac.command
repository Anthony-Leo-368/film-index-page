#!/bin/bash
cd "$(dirname "$0")" || exit 1
echo "==============================================================="
echo "  胶卷索引 · 本地服务"
echo "  （会读 Excel 生成快照，并在浏览器中打开索引页）"
echo "  用完后关闭这个窗口即可停止服务。"
echo "==============================================================="
echo
/usr/bin/python3 assets/worker.py --serve
